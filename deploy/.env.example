# Va en el VPS como $VPS_DIR/.env (lo leen systemd y la app).
# Dirección donde escucha PocketBase. Con Nginx/Caddy delante: 127.0.0.1:8090.
# Sin proxy: 0.0.0.0:8090
HTTP_ADDR=127.0.0.1:8090

APP_DEV=produccion
EMAIL_ROL=
EMAIL_INIT_DIR=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Facturación electrónica con Formi (https://integraciones.formi.ec)
FORMI_API_KEY=
# FORMI_URL=https://integraciones.formi.ec
# Token secreto del webhook. Al crear la API key en Formi, el webhook debe ser:
#   https://<tu-dominio>/api/facturacion/webhook?token=<FORMI_WEBHOOK_TOKEN>
FORMI_WEBHOOK_TOKEN=
